# =========================================================================
# Local SQLite Database Storage & Encryption Safeties
# =========================================================================
/db/*.sqlite3
/db/*.sqlite3-journal
/db/*.sqlite3-shm
/db/*.sqlite3-wal

# Ensure the Rails environment credentials master key is never leaked
/config/master.key
/config/credentials/*.key

# =========================================================================
# Background Job Cache & System Automation Logs
# =========================================================================
/log/*.log
/log/cron.log
/tmp/cache/
/tmp/sockets/
/tmp/pids/
.clear-crontab

# Mac OS metadata noise files
.DS_Store

